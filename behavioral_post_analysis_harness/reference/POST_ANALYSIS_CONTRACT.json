  "nort": {
    "source_ref": "SRC-NORT",
    "aliases": [
      "NORT",
      "NOR"
    ],
    "purpose": "Recognition-memory readout; report raw exploration times with DI/RI.",
    "protocol": {
      "habituation": "empty arena",
      "familiarization_duration_s": 360,
      "familiarization_objects": "two identical objects",
      "delay_h": 5,
      "test_duration_s": 360,
      "test_objects": [
        "one familiar",
        "one novel"
      ],
      "counterbalance": "object positions/configurations",
      "time_origin_specified": false
    },
    "exploration_rules": {
      "object_geometry": "object mask/convex hull",
      "interaction_zone_distance_cm": 3,
      "candidate": {
        "body_centroid": "outside object mask",
        "nose_distance_to_perimeter_cm": {
          "operator": "<=",
          "value": 3
        },
        "direction": "head oriented toward object or nose contact"
      },
      "head_angle": {
        "aggregation": "bout-level median",
        "operator": "<=",
        "degrees": 45,
        "brief_frame_level_failures": "do not remove good bouts"
      },
      "merge": {
        "gap_operator": "<",
        "gap_s": 0.5,
        "order": "before duration filter"
      },
      "valid_bout": {
        "duration_s": {
          "operator": ">=",
          "value": 1.0
        },
        "nose_speed_m_per_s": {
          "aggregation": "bout-level median",
          "operator": "<",
          "value": 0.05
        }
      },
      "exclusions": "Do not count climbing/sitting on the object, grooming, or rearing unless clearly object-directed."
    },
    "training_inputs": {
      "TA": "exploration time Object A",
      "TB": "exploration time Object B"
    },
    "training_formulas": {
      "total_training_exploration": "TA + TB",
      "object_bias": "(TA - TB) / (TA + TB)",
      "side_bias": "(TB - TA) / (TA + TB)"
    },
    "test_inputs": {
      "TN": "novel object exploration time",
      "TF": "familiar object exploration time"
    },
    "test_formulas": {
      "total_test_exploration": "TN + TF",
      "DI": "(TN - TF) / (TN + TF)",
      "RI": "TN / (TN + TF)",
      "percent_novel": "100 * RI",
      "LR": "ln(TN / TF)"
    },
    "source_missing_rules": [
      {
        "when": "TN + TF = 0",
        "outputs": [
          "DI",
          "RI",
          "percent_novel"
        ],
        "result": "NA"
      },
      {
        "when": "TN = 0 OR TF = 0",
        "outputs": [
          "LR"
        ],
        "result": "NA unless a predefined pseudocount is used"
      }
    ],
